# Mẫu biến môi trường — CHỈ GIÁ TRỊ GIẢ. Sao chép thành .env (không commit) hoặc đặt
# trong Railway > Variables. Không bao giờ dán khoá thật vào code/chat/issue.

# Bắt buộc. >= 32 byte, ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (production từ chối khởi động nếu còn là giá trị mẫu này)
MEDASSIST_SECRET_KEY=thay-bang-khoa-ngau-nhien-toi-thieu-32-byte-xxxxxxxx

# production -> bật kiểm tra khoá mẫu/yếu lúc khởi động
MEDASSIST_ENV=development

# Đường dẫn SQLite. Railway: gắn Volume tại /data rồi đặt /data/medassist.db
MEDASSIST_DB=data/medassist.dev.db

# 1 -> nạp danh mục thuốc MẪU khi bảng thuốc rỗng (Dockerfile đặt sẵn = 1)
MEDASSIST_SEED_IF_EMPTY=0

# mock (mặc định, offline) | ollama (chỉ localhost) | claude (cần đồng ý từng lượt)
MEDASSIST_LLM=mock

# Chỉ cần khi MEDASSIST_LLM=claude. Giá trị giả:
ANTHROPIC_API_KEY=sk-ant-FAKE-PLACEHOLDER-DO-NOT-USE
# Tuỳ chọn, mặc định claude-sonnet-5-5
MEDASSIST_CLAUDE_MODEL=claude-sonnet-5-5
