<?xml version="1.0" encoding="utf-8"?>
<!--
  CHỈ DÙNG CHO DEBUG (file nằm trong src/debug/).
  Cho phép HTTP cleartext tới server dev (Flask/FastAPI chạy trên máy host):
    - 10.0.2.2  = localhost của máy host nhìn từ Android emulator
    - localhost / 127.0.0.1 = khi dùng adb reverse (adb reverse tcp:5000 tcp:5000)
  Bản release KHÔNG có file này -> bắt buộc dùng HTTPS.
  Lý do cần: từ Android 9 (API 28), cleartext HTTP bị chặn mặc định; Flutter/dart:io
  cũng chặn theo policy của nền tảng ("Insecure HTTP is not allowed by platform").
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
